# Edge Gateway Configuration

# Gateway
GATEWAY_ID=gateway-01
KENNEL_ID=kennel-01

# MQTT (local broker)
MQTT_HOST=mosquitto
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Backend URLs - Auto-selects local or cloud
# Priority: LOCAL_BACKEND_URL > CLOUD_BACKEND_URL
LOCAL_BACKEND_URL=http://localhost:3000
CLOUD_BACKEND_URL=https://api.petsmart.example.com
API_KEY=smart-pet-api-key-2026

# SQLite
SQLITE_PATH=./data/gateway.db

# Sync settings
SYNC_INTERVAL=30000
OFFLINE_QUEUE_LIMIT=1000

# Heartbeat
HEARTBEAT_INTERVAL=60000

# ── Pet Hub ────────────────────────────────────────────────────────────────
# Local HTTP API (health / devices / events / schedules / commands)
HTTP_PORT=3004
# Local schedule runner — fires feed/dispense on the LAN clock. 0 disables.
SCHEDULE_TICK_INTERVAL=30000

# Cloud MQTT bridge (leave CLOUD_MQTT_URL unset to disable).
# This is how a home hub reaches smart-pet-backend, which consumes MQTT.
# CLOUD_MQTT_URL=mqtts://broker.example.com:8883
# CLOUD_MQTT_USERNAME=
# CLOUD_MQTT_PASSWORD=

# Legacy HTTP sync to /api/iot/* is off unless this is true.
HTTP_SYNC_ENABLED=false
